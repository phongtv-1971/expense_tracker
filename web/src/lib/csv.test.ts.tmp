import { describe, it, expect } from 'vitest'
import { exportTransactionsCSV, dedupeTransactions } from './csv'

describe('csv export', () => {
  it('generates CSV string without throwing', () => {
    const txs = [
      { id: '1', date: '2026-01-01', amount: 10, type: 'expense', category: 'Food', notes: 'Lunch' }
    ]
    // exportTransactionsCSV triggers download; ensure function exists and does not throw
    expect(() => exportTransactionsCSV(txs as any)).not.toThrow()
  })
})

describe('csv dedupeTransactions', () => {
  it('skips exact duplicates by date|amount|notes', () => {
    const existing = [{ id: '1', date: '2026-01-01', amount: 10, type: 'expense', notes: 'Lunch', category: '' }]
    const incoming = [{ id: '', date: '2026-01-01', amount: 10, type: 'expense', notes: ' Lunch ', category: '' }]
    const { toAdd, skipped } = dedupeTransactions(existing as any, incoming as any)
    expect(toAdd.length).toBe(0)
    expect(skipped.length).toBe(1)
  })
  it('allows different amounts', () => {
    const existing = [{ id: '1', date: '2026-01-01', amount: 10, type: 'expense', notes: 'Lunch', category: '' }]
    const incoming = [{ id: '', date: '2026-01-01', amount: 12, type: 'expense', notes: 'Lunch', category: '' }]
    const { toAdd, skipped } = dedupeTransactions(existing as any, incoming as any)
    expect(toAdd.length).toBe(1)
    expect(skipped.length).toBe(0)
  })
})
